# ============================================================
# School Management System — environment variables
# ------------------------------------------------------------
# 1. Copy this file to .env  (cp .env.example .env)
# 2. Fill in your real values below
# 3. NEVER commit the real .env — it is gitignored
# 4. On Vercel: Project Settings -> Environment Variables,
#    add these same keys there (they are injected automatically)
# ============================================================

# --- Server ---
# Local dev port (Vercel ignores this)
PORT=4321

# --- Turso (live data: students, fees, users...) — serverless SQLite ---
# 1. https://turso.tech -> free signup -> create a database
# 2. Copy the database URL (libsql://<name>-<org>.<region>.turso.io)
# 3. IMPORTANT: generate a DATABASE token, not an API token:
#    console.turso.tech -> Databases -> <your db> -> Generate Token.
#    (API tokens from Settings -> API Tokens only work with the Turso API,
#    NOT with database connections.)
# 4. When TURSO_URL is set, the app uses Turso (Vercel/production). Without it,
#    the app uses the local data/school.db SQLite file (dev).
TURSO_URL=
TURSO_AUTH_TOKEN=

# --- MongoDB Atlas (kept for reference; the app now uses Turso) ---
MONGODB_URI=

# --- Backblaze B2 (automatic backups + future file uploads) ---
# 1. https://secure.backblazeb2.com -> Create Bucket (Private)
# 2. App Keys -> Generate New Key (give access only to that bucket)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=sms-main-backups
# Region endpoint shown on your bucket page, e.g. s3.us-west-004.backblazeb2.com
B2_ENDPOINT=

# --- Sessions ---
# Long random string used to sign login cookies.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
